{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true, "noImplicitAny": false,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": false, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["server/src", "shared", "scripts", "tests"]
}
